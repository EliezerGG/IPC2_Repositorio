    {
      "name": "0 Preparacion",
      "item": [
        {
          "name": "Reiniciar datos con ejemplo (200)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reiniciar?ejemplo=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reiniciar"
              ],
              "query": [
                {
                  "key": "ejemplo",
                  "value": "true"
                }
              ]
            },
            "description": "borra todo y vuelve a cargar los cinco productos de ejemplo. conviene ejecutarlo antes de probar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('estado 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('avisa que cargo los datos de ejemplo', function () { pm.expect(pm.response.json().datosDeEjemplo).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
