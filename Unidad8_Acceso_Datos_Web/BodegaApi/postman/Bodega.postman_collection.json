    {
      "name": "3 Lotes (un json con lista)",
      "item": [
        {
          "name": "Lote correcto (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/movimientos/lote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movimientos",
                "lote"
              ]
            },
            "description": "un json con una lista: se procesan todos dentro de una sola transaccion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movimientos\": [\n    {\n      \"codigo\": \"REP-003\",\n      \"tipo\": \"entrada\",\n      \"cantidad\": 15,\n      \"motivo\": \"compra a proveedor\"\n    },\n    {\n      \"codigo\": \"REP-001\",\n      \"tipo\": \"salida\",\n      \"cantidad\": 5,\n      \"motivo\": \"venta mostrador\"\n    },\n    {\n      \"codigo\": \"REP-002\",\n      \"tipo\": \"entrada\",\n      \"cantidad\": 6,\n      \"motivo\": \"reposicion\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('estado 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('el resumen suma bien', function () {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.procesados).to.eql(3);",
                  "  pm.expect(r.unidadesEntrada).to.eql(21);",
                  "  pm.expect(r.unidadesSalida).to.eql(5);",
                  "  pm.expect(r.movimientos).to.have.lengthOf(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lote con un error (409 y rollback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/movimientos/lote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movimientos",
                "lote"
              ]
            },
            "description": "el segundo movimiento falla, asi que el primero tambien se deshace.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movimientos\": [\n    {\n      \"codigo\": \"REP-003\",\n      \"tipo\": \"entrada\",\n      \"cantidad\": 5\n    },\n    {\n      \"codigo\": \"REP-002\",\n      \"tipo\": \"salida\",\n      \"cantidad\": 90000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// guardamos el stock de rep-003 antes de enviar el lote",
                  "pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/api/productos/REP-003', function (err, res) {",
                  "  pm.collectionVariables.set('stockAntes', res.json().stock);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('estado 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('el error indica cual movimiento fallo', function () { pm.expect(pm.response.json().error).to.include('movimiento 2'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar que el rollback no cambio nada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/REP-003",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "REP-003"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('estado 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('el stock de REP-003 sigue igual que antes del lote', function () {",
                  "  pm.expect(pm.response.json().stock).to.eql(Number(pm.collectionVariables.get('stockAntes')));",
                  "});"
                ]
              }
            }
          ]
        },
