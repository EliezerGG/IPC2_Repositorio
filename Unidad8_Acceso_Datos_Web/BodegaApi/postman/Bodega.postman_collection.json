        {
          "name": "Crear producto (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "post con un json en el cuerpo. responde 201 Created y la cabecera location.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigoNuevo}}\",\n  \"nombre\": \"Amortiguador delantero\",\n  \"stock\": 4,\n  \"stockMinimo\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// genera un codigo distinto en cada ejecucion para poder repetir la coleccion",
                  "pm.collectionVariables.set('codigoNuevo', 'REP-' + Math.floor(1000 + Math.random() * 9000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('estado 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('la cabecera location apunta al recurso creado', function () {",
                  "  pm.expect(pm.response.headers.get('Location')).to.include(pm.collectionVariables.get('codigoNuevo'));",
                  "});",
                  "pm.test('el cuerpo trae el producto', function () {",
                  "  pm.expect(pm.response.json().codigo).to.eql(pm.collectionVariables.get('codigoNuevo'));",
                  "});"
                ]
              }
            }
          ]
        },
